# Ganz Tasmanien, nur wo LiDAR vorhanden ist (theLIST Tree Canopy Height, archiviert im Release tas-chm).
# Vorher einmal den Workflow "Archive Tasmania canopy" laufen lassen.
NAME=tasmanien-baumhoehe
TITLE="Baumhöhe Tasmanien (LiDAR)"
BBOX=143.80,-43.70,148.50,-39.55
MINZOOM=8
MAXZOOM=14
ZSPLIT=11
SHARDS=20
PARTITION=contiguous
PALETTE=riesen
SOURCE=index:https://github.com/lorenzdenk/render-baumhoehen-overlay/releases/download/tas-chm/index.csv
OSM_PBF=https://download.geofabrik.de/australia-oceania/australia-latest.osm.pbf
OSM_BBOX=143.5,-44.0,149.0,-39.3
DESCRIPTION="Baumhöhe (Kronenhöhe über Grund) aus theLIST Tree Canopy Height (LiDAR, 2 m), nur Gebiete mit LiDAR; ab 50 m hervorgehoben; Gebäude nach OSM ausmaskiert"
ATTRIBUTION="Baumhöhe: Tree Canopy Height, theLIST © State of Tasmania, CC BY 3.0 AU, Daten geändert; Maske © OpenStreetMap-Mitwirkende"
